# Nivel 1 — Secretos de infraestructura
# Copia este archivo a .env y rellena los valores. NUNCA commitees .env.
#
# Los secretos vienen VACÍOS a propósito: no hay ningún valor de ejemplo que
# funcione. Al lado de cada uno tienes el comando que lo genera.
#
# Cómo generar cada secreto (un comando por línea, en tu terminal):
#   POSTGRES_PASSWORD  →  openssl rand -hex 24
#   JWT_SECRET         →  openssl rand -base64 48
#   ENCRYPTION_KEY     →  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️ POSTGRES_PASSWORD con -hex, NUNCA con -base64. Esa contraseña viaja dentro
# de la URL de conexión (DATABASE_URL) y el base64 mete símbolos como "+" o "/"
# que la rompen: el backend no puede entrar y verás "P1000 Authentication
# failed". Con -hex solo salen números y letras de la a a la f.

# === Aplicación ===
# Nombre visible de la instalación (título de la API, emails transaccionales,
# páginas OAuth). El panel (frontend) tiene su propia variable: APP_NAME en el
# entorno del contenedor nginx (runtime) o VITE_APP_NAME en el build.
APP_NAME=Chatbot
APP_ENV=development
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# === Base de datos ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=chatbot
POSTGRES_DB=chatbot
# Genera con: openssl rand -hex 24   (hex, no base64 — lee el aviso de arriba)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://chatbot:${POSTGRES_PASSWORD}@db:5432/chatbot

# === Redis (cola Celery + buffer mensajes) ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === Seguridad ===
# Firma de las sesiones. Mínimo 32 caracteres o el backend aborta el arranque.
# Va suelto (no dentro de una URL), así que base64 aquí no da problemas.
# Genera con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# Cifra las credenciales de proveedores que guardes desde el panel. Formato
# Fernet (32 bytes en base64 urlsafe); también va suelto, no en ninguna URL.
# Genera con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OJO: si la cambias después, hay que volver a introducir TODAS las claves de
# proveedores desde el panel (las cifradas con la vieja dejan de leerse).
ENCRYPTION_KEY=

# === Admin inicial (seed) ===
# Obligatorios en producción: el arranque ABORTA si quedan vacíos o con el
# default de fábrica (admin@local / ChangeMe123!).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Contacto VAPID para Web Push (opcional). Vacío = se deriva del email admin.
# VAPID_SUBJECT=mailto:tu@email.com

# Prefijo de los ficheros de backup local (opcional). Vacío = se deriva del
# nombre de la base de datos.
# BACKUP_FILE_PREFIX=

# Operador cliente opcional. Solo se crea si AMBOS están definidos.
# Si no los pones, no se crea ningún usuario "cliente" en el seed.
INITIAL_CLIENT_EMAIL=
INITIAL_CLIENT_PASSWORD=

# === Storage ===
# Carpeta dentro del contenedor donde se guardan audios. Montar como volumen.
AUDIO_STORAGE_PATH=/data/audios

# === Comportamiento del agente (defaults — editables desde el panel admin) ===
DEFAULT_LLM_MODEL=gpt-5.4-mini
# OJO: DEFAULT_LLM_TEMPERATURE y DEFAULT_LLM_MAX_TOKENS YA NO SE LEEN de aquí.
# Los modelos GPT-5.x no aceptan ajuste de temperatura y el máximo de tokens lo
# gestiona OpenAI. Ponerlas no hace nada; se quitan para no confundir.
# Segundos que el agente espera para agrupar ráfagas de mensajes (mín. 1; el
# panel impide 0). 8-12 agrupa mejor; menos responde más rápido.
MESSAGE_BUFFER_SECONDS=8
# Suelo de esa espera para los canales de texto: evita que el agente conteste a
# trocitos aunque el agente esté mal configurado. La voz no aplica este suelo.
MIN_TEXT_BUFFER_SECONDS=6
RESPONSE_SPLIT_MAX_PARTS=3
# Cuántos mensajes anteriores ve el agente como contexto.
DEFAULT_CONTEXT_WINDOW=20
# En false, las conversaciones nuevas nacen en "humano" y el agente NO contesta
# solo. Útil mientras entrenas al agente.
AGENT_AUTORESPONSE_DEFAULT=true

# === Panel y métricas ===
# Dominios que pueden llamar a la API desde un navegador, separados por comas.
# Con https y SIN barra final, o el navegador dará error de CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Zona horaria del negocio: con ella se agrupan las métricas del Inicio ("hoy",
# "ayer", por horas). Sin esto se leerían en UTC. Formato Continente/Ciudad.
DASHBOARD_TIMEZONE=Europe/Madrid

# === Carpetas de datos ===
# ⚠️ Las tres cuelgan de AUDIO_STORAGE_PATH a propósito: en producción ese es el
# ÚNICO volumen persistente. Lo que se escriba fuera se pierde al recrear el
# contenedor (y con ello, las copias de seguridad).
# Ficheros que envía el operador desde el panel (audios, imágenes, documentos).
UPLOADS_PATH=/data/audios/uploads
# Copias de seguridad guardadas en el propio servidor.
BACKUP_DIR=/data/audios/backups
# Días que se conserva cada copia local y tope de copias, ADEMÁS de los días
# (sin tope, una frecuencia horaria llena el disco antes de caducar ninguna).
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_MAX_FILES=14
# Si quedan menos GB libres que esto, no se escribe la copia en el servidor.
BACKUP_MIN_FREE_GB=2.0

# === Cuánto se guarda cada cosa (retenciones — protección de datos) ===
# En días salvo donde se diga. Una tarea diaria hace la limpieza. 0 = no limpiar.
# Fichero de las notas de voz (la transcripción se conserva siempre).
AUDIO_RETENTION_DAYS=270
# Adjuntos: imágenes, vídeos y documentos. La fila del mensaje se conserva.
MEDIA_RETENTION_DAYS=180
# ESTA VA EN MESES: pasado ese tiempo se vacía el contenido de los correos
# guardados (Gmail es el archivo; la base de datos, una copia de trabajo).
EMAIL_RETENTION_MONTHS=6
# Trazas del agente: cortas a propósito, llevan trozos de mensajes en claro.
TRACE_RETENTION_DAYS=30
LLM_USAGE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
OUTBOUND_RETENTION_DAYS=180
# Huecos de conocimiento ya resueltos (los pendientes no caducan nunca).
RESOLVED_GAP_RETENTION_DAYS=180

# === Endurecimiento (opcionales — tienen default seguro) ===
# Nº de proxies de confianza por delante (EasyPanel/nginx suele ser 1). Se usa
# para derivar la IP real del cliente del header X-Forwarded-For en el rate-limit.
TRUSTED_PROXY_COUNT=1
# Valida el call_id del WebSocket de voz (Retell) contra su API antes de atender.
# Es la ÚNICA autenticación de ese WebSocket. NO LO APAGUES: en false queda
# abierto a internet y cualquiera puede inyectar turnos, gastar tokens y ejecutar
# las tools del agente (agendar citas reales incluido) y escribir en la BD.
# La validación es fail-closed (reintenta una vez y, si no puede validar, rechaza).
RETELL_WS_VALIDATE=true
# Intentos de conexión al WebSocket de voz por IP y minuto (antipico/abuso: cada
# intento cuesta peticiones a la API de Retell del cliente). 0 = sin límite.
RETELL_WS_MAX_ATTEMPTS_PER_MIN=20
# Llamadas de voz simultáneas que atiende este proceso como máximo.
RETELL_MAX_CONCURRENT_CALLS=20
# Segundos máximos de espera al agente por turno de voz antes de disculparse.
RETELL_TURN_TIMEOUT_SECONDS=25
# Tarifa de telefonía de Retell por minuto en USD (sin el LLM). Solo para mostrar
# el coste estimado de cada llamada en la sección "Llamadas". 0 = no mostrarlo.
RETELL_PRICE_PER_MINUTE_USD=0
# Diagnóstico TEMPORAL del webhook de Instagram en "Logs en vivo" (solo para
# depurar el parser de notas de voz). Mantener en false en producción.
IG_WEBHOOK_DEBUG=false

# === Afinado fino (casi nunca hay que tocar nada de esto) ===
# Todas tienen un valor por defecto que funciona. Están aquí para que se sepa
# que existen; van comentadas porque lo normal es no ponerlas.
# Búsqueda en la base de conocimiento: umbral de parecido (0-1) y cuántos
# fragmentos se le pasan al agente. Sube el umbral si el agente mete en sus
# respuestas trozos que no vienen a cuento.
# KB_MATCH_THRESHOLD=0.3
# KB_TOP_K_DEFAULT=5
# Tamaño máximo de cada tipo de archivo entrante, en bytes. Son los límites de
# WhatsApp Business: subirlos no hace que WhatsApp acepte más.
# MEDIA_MAX_IMAGE_BYTES=5242880
# MEDIA_MAX_AUDIO_BYTES=16777216
# MEDIA_MAX_VIDEO_BYTES=16777216
# MEDIA_MAX_DOCUMENT_BYTES=104857600
# MEDIA_MAX_STICKER_BYTES=1048576
# Modelo de embeddings (el que convierte los documentos en algo buscable).
# Cambiarlo obliga a reindexar TODA la base de conocimiento.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Con quién habla el canal de WhatsApp: "ycloud" (un intermediario) o "meta"
# (la API Cloud oficial, sin intermediario). NORMALMENTE NO SE TOCA: la
# elección se hace desde el panel, en Conexiones → WhatsApp, y se guarda con el
# canal. Esto es solo el valor de partida de una instalación recién montada.
# WHATSAPP_PROVIDER=ycloud
# YCLOUD_BASE_URL=https://api.ycloud.com/v2
# Versión de la API de Meta que se usa cuando el canal va directo a Meta. Está
# aquí porque Meta retira cada versión a los dos años: el día que toque se sube
# la versión sin tener que desplegar código.
# META_WA_GRAPH_VERSION=v25.0
# Algoritmo con el que se firman las sesiones. No lo cambies sin motivo:
# invalida todas las sesiones abiertas.
# JWT_ALGORITHM=HS256
# Comprobación diaria de las copias (conexión al bucket + descarga y descifrado
# de la última copia para verificar que sirve). Déjalo encendido.
# BACKUP_DAILY_CHECKS=true
# Tamaño de bloque (MB) al cifrar y subir la copia directa al bucket.
# BACKUP_STREAM_CHUNK_MB=8

# === Nivel 2 — Credenciales de proveedores ===
# Estos valores también pueden gestionarse desde el panel admin (cifrados en DB).
# El .env es el fallback inicial / arranque.

# YCloud (WhatsApp Business API)
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_PHONE_NUMBER=

# OpenAI (LLM + embeddings + transcripción de notas de voz)
OPENAI_API_KEY=
# Modelo de transcripción (opcional; default seguro = gpt-4o-mini-transcribe,
# el más reciente y barato). La transcripción es SIEMPRE de OpenAI: el fallback
# de LLM (OpenRouter/deepseek) NO transcribe.
# OPENAI_WHISPER_MODEL=gpt-4o-mini-transcribe

# Fallback de LLM (opcional): si OpenAI falla, el agente reintenta con un
# proveedor secundario compatible OpenAI. Se configura en el panel
# (Admin → Credenciales): llm_fallback_api_key (+ opcionalmente base_url y
# modelo; por defecto OpenRouter + deepseek). No hace falta nada en .env.

# Resend (email transaccional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Telegram (notificaciones equipo derivación humana)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack (notificaciones equipo derivación humana)
SLACK_WEBHOOK_URL=

# OAuth — las únicas claves de proveedor que conviene tener como variables,
# porque hacen falta para montar el propio botón de "conectar".
# Google (login con Google + Gmail + Calendar): una sola app de Google Cloud
# Console sirve para los tres. Las URL de retorno se calculan solas a partir de
# APP_BASE_URL si no defines las de abajo.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=      # servicios; default ${APP_BASE_URL}/api/v1/oauth/google/callback
# GOOGLE_LOGIN_REDIRECT_URI=      # login;     default ${APP_BASE_URL}/api/v1/auth/google/callback

# Instagram Business Login (app de Meta). Son el mismo par que el App ID y el
# App Secret de Facebook: cuando los rotes, cámbialos en los dos sitios.
# El verify_token y el app_secret del WEBHOOK se configuran en el canal, desde
# el panel, no aquí (ver DEPLOY_EASYPANEL.md § 6.b).
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
# INSTAGRAM_OAUTH_REDIRECT_URI=
