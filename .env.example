# Variables del despliegue. Es lo que EasyPanel importa al crear el servicio
# desde docker-compose.easypanel.yml: rellena estos huecos y ya está.
#
# Solo hay 12. El resto (base de datos, Redis, colas, puertos, rutas, copias,
# retenciones) las arma el propio compose, y las claves de proveedores —OpenAI,
# WhatsApp, Instagram, Resend…— se ponen luego desde el panel, cifradas.
#
# Para trabajar en local: .env.desarrollo.example
# Lista completa de opcionales con su valor por defecto: anexo de DEPLOY_EASYPANEL.md

# === Aplicación ===
# En los dominios: con https, SIN barra final.
APP_NAME=Chatbot
APP_BASE_URL=https://api.TU-DOMINIO
FRONTEND_BASE_URL=https://TU-DOMINIO
MCP_BASE_URL=https://mcp.TU-DOMINIO

# === Base de datos ===
# POSTGRES_PASSWORD con: openssl rand -hex 24   (hex, nunca base64)
POSTGRES_USER=chatbot
POSTGRES_DB=chatbot
POSTGRES_PASSWORD=

# === Seguridad ===
# JWT_SECRET con:     openssl rand -base64 48
# ENCRYPTION_KEY con: openssl rand -base64 32 | tr '+/' '-_'
JWT_SECRET=
ENCRYPTION_KEY=

# === Admin inicial ===
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# === Ajustes ===
TRUSTED_PROXY_COUNT=1
DEFAULT_LLM_MODEL=gpt-5.4-mini
